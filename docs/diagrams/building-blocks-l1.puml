rectangle "Application Layer\n\nBetreuerReadService\nBetreuerWriteService\nThemaService\nMatchingService\nAppUserService" as App

rectangle "Domain Layer\n\nBetreuer\nThema\nMatching\nMatchingResult\nFile\nFileType\nTagCatalog\nVeranstaltungCatalog\nVeranstaltungenListe" as Domain

