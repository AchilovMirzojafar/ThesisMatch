@startuml
title Bausteinsicht Level 1 – Thesis-Matching-Plattform
skinparam shadowing false
top to bottom direction

rectangle "Config\n\nSecurityConfig\nAppUserService" as Config

rectangle "Web Layer\n\nAdminController\nBetreuerController\nStudentController\nForm-Objekte\n@AdminOnly, @BetreuerOnly" as Web

rectangle "Application Layer\n\nBetreuerReadService\nBetreuerWriteService\nThemaService\nMatchingService\nBetreuerRepository (Interface)" as App

rectangle "Domain Layer\n\nBetreuer (Aggregate Root)\nThema\nGitHubId, Email (Value Objects)\nMatchingResult\nMatchingCalculator (Domain Service)\nTagCatalog\nVeranstaltungCatalog" as Domain

rectangle "Persistence Adapter Layer\n\nBetreuerRepositoryImpl\nBetreuerDaoRepository\nDTOs (BetreuerDTO, ThemaDTO, ...)" as Persistence

Web --> App
Config --> App
App --> Domain
Persistence --> App : implements BetreuerRepository
Persistence --> Domain

@enduml
